# MySQL/MariaDB connection string.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings
DATABASE_URL="mysql://user:password@127.0.0.1:3306/mi_hawk"

# Shared secret used to authenticate checker nodes calling /api/checker/*.
# Must match CHECKER_API_KEY in each checker node's .env file.
CHECKER_API_KEY="replace-with-a-long-random-secret"

# Admin login credentials for the Mi-hawk dashboard. There is no self-registration —
# this is the single admin account.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ChangeMe123!"

# Secret used to sign admin session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-secret"

# Whether the admin session cookie requires HTTPS (Secure flag). Defaults to true.
# Set to "false" only if serving the dashboard over plain HTTP (e.g. an IP address
# with no TLS/domain configured) — otherwise browsers will silently drop the cookie
# and login will appear to fail.
COOKIE_SECURE="true"

# Globalping API keys for the distributed domain checker (scripts/globalping-checker.ts).
# Separate keys allow independent rate-limit pools for each region.
# Get keys at https://globalping.io
GLOBALPING_API_KEY_INDIA=""
GLOBALPING_API_KEY_INDONESIA=""

# SMTP credentials used to send Alert Settings email notifications. Leave unset
# to disable email alerts (they'll be skipped with a logged warning). Works with
# any SMTP provider, e.g. Gmail app passwords, SendGrid, Mailgun, etc.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
# "From" address for alert emails. Defaults to SMTP_USER if unset.
SMTP_FROM=""
