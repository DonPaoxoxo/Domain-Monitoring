# URL of the main Mi-hawk server (no trailing slash)
MAIN_SERVER_URL=https://dashboard.example.com

# Must match CHECKER_API_KEY on the main server
CHECKER_API_KEY=replace-with-a-long-random-secret

# Identifies this checker process in logs and stored results
NODE_NAME=india-checker-1

# Region key as used by the dashboard: india | indonesia | global
REGION_NAME=india

# Specific checkpoint location this node represents
LOCATION_NAME=Mumbai

# How often to run a full check cycle, in minutes
CHECK_INTERVAL_MINUTES=60

# How many domains to check concurrently per batch
BATCH_SIZE=20
